{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ${mod_authors},
  "contact": {
    "homepage": "${mod_website}",
    "issues": "${mod_issues}",
    "sources": "${mod_website}"
  },
  "license": "${mod_license}",
  "entrypoints": {
    "main": ["${entrypoint}"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "=${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*",
    "polymer-core": "*",
    "polymer-blocks": "*",
    "polymer-resource-pack": "*",
    "polymer-virtual-entity": "*"
  },
  "environment": "server",
  "accessWidener": "serversidetrains.classtweaker",
  "mixins": [
    "serversidetrains.mixins.json"
  ]
}
